# Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública. O Supabase renomeou as chaves de API: use a publishable
# (sb_publishable_...). Projetos antigos ainda podem usar
# NEXT_PUBLIC_SUPABASE_ANON_KEY, que também é aceita.
# Nunca coloque aqui uma sb_secret_... / service_role: ela ignora o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Usada para montar os links de indicação e da loja.
# Em produção, troque pela URL real do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
