# Supabase > Settings > API > "Project URL"
#
# Só o endereço do projeto, SEM caminho no final. Copiar a URL da API REST
# (.../rest/v1) faz o login e o cadastro devolverem 404, porque o supabase-js
# monta /auth/v1/... em cima do que estiver aqui.
#   correto: https://seu-projeto.supabase.co
#   errado:  https://seu-projeto.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública. O Supabase renomeou as chaves de API: use a publishable
# (sb_publishable_...). Projetos antigos ainda podem usar
# NEXT_PUBLIC_SUPABASE_ANON_KEY, que também é aceita.
# Nunca coloque aqui uma sb_secret_... / service_role: ela ignora o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Usada para montar os links de indicação e da loja.
# Em produção, troque pela URL real do site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
